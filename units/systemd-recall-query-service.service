#
# systemd-recall-query-service.service — AI-powered query service for captured data
#

[Unit]
Description=AI-Powered Query Service for systemd-recalld
Documentation=man:systemd-recall-query-service(8)
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
ExecStart=/usr/lib/systemd/systemd-recall-query-service
Restart=on-failure
RestartSec=10

# Security
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes

# State directory
StateDirectory=systemd/recall-query-service
CacheDirectory=systemd/recall-query-service
LogsDirectory=systemd/recall-query-service

# Resource management
IOSchedulingClass=best-effort
IOSchedulingPriority=3
CPUWeight=80
MemoryMax=8G

# Watchdog
WatchdogSec=60

[Install]
WantedBy=multi-user.target
